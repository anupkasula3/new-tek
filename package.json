{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build && powershell -Command \"if (!(Test-Path public_html/build)) { New-Item -ItemType Directory -Path public_html/build | Out-Null }; Copy-Item -Recurse -Force public/build/* public_html/build/\"",
        "build:prod": "vite build && npm run build:copy",
        "build:copy": "powershell -Command \"if (!(Test-Path public_html/build)) { New-Item -ItemType Directory -Path public_html/build | Out-Null }; Copy-Item -Recurse -Force public/build/* public_html/build/\"",
        "dev": "vite"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.2",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.9.3",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "@fancyapps/ui": "^6.1.14",
        "@splidejs/react-splide": "^0.7.12",
        "framer-motion": "^12.23.26",
        "html-to-image": "^1.11.13",
        "html2canvas": "^1.4.1",
        "jspdf": "^4.2.1",
        "lucide-react": "^0.562.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-helmet-async": "^2.0.5",
        "react-router-dom": "^7.12.0"
    }
}
